<view class="user-card" wx:if="{{user && user.id}}">
  <view class="user-avatar" wx:if="{{user.avatarUrl}}" catchtap="onAvatarTap">
    <image class="avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
  </view>
  <view class="user-avatar default" wx:else catchtap="onAvatarTap">
    <text class="avatar-text">{{displayNicknameInitial}}</text>
  </view>

  <view class="user-info" catchtap="onAvatarTap">
    <text class="user-nickname">{{displayNickname}}</text>
  </view>

  <view class="home-entry" catchtap="onSelectorTap" wx:if="{{showQuickActions}}">
    <image class="home-entry-icon" src="/images/主页.png" mode="aspectFit" />
  </view>

  <view class="user-quick-group" wx:if="{{showQuickActions}}">
    <view class="user-quick-entry" catchtap="onMessageTap">
      <view class="message-badge" wx:if="{{showMessageBadge && unreadMessageCount > 0}}">{{unreadMessageCount > 99 ? '99+' : unreadMessageCount}}</view>
      <image class="user-quick-icon" src="/images/消息.png" mode="aspectFit" />
    </view>
    <view class="user-quick-entry" catchtap="onSocialTap">
      <image class="user-quick-icon" src="/images/好友.png" mode="aspectFit" />
    </view>
  </view>
</view>

<view class="user-card placeholder" wx:if="{{!user || !user.id}}">
  <view class="user-avatar default">
    <text class="avatar-text">芋</text>
  </view>
  <view class="user-info">
    <text class="user-nickname">访客</text>
  </view>
</view>