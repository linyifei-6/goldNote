<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <top-user-card
    user="{{user}}"
    bindavatar="onOpenProfileModal"
    bindselector="onGoSelector"
    bindwedding="onGoWedding"
    bindmessage="onGoSelector"
    bindsocial="onGoSocial"
  />

  <view class="card leaderboard-card" wx:if="{{user}}">
    <view class="card-title-row">
      <view class="card-title">黄金排行榜</view>
      <view class="leaderboard-search">
        <input class="leaderboard-search-input" placeholder="搜索用户ID" value="{{goldPreviewUserId}}" bindinput="onGoldPreviewInput" />
        <text class="leaderboard-search-btn" bindtap="onCheckGoldPreview">搜索</text>
      </view>
    </view>
    <view class="leaderboard-tabs">
      <view
        class="leaderboard-tab {{leaderboardActiveKey === item.key ? 'active' : ''}}"
        wx:for="{{leaderboardTabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onLeaderboardTabTap"
      >
        <text class="leaderboard-tab-text">{{item.label}}</text>
      </view>
    </view>
    <view class="leaderboard-sub">系统前十名，点击头像或昵称可查看访客页。</view>
    <view class="leaderboard-empty" wx:if="{{leaderboardList.length === 0}}">暂无排行数据</view>
    <view class="leaderboard-item" wx:for="{{leaderboardList}}" wx:key="rank">
      <view class="leaderboard-rank {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</view>
      <view class="leaderboard-avatar" data-user-id="{{item.user.id}}" bindtap="onOpenVisitorFromLeaderboard">
        <image class="leaderboard-avatar-img" wx:if="{{item.user.avatarUrl && !brokenAvatarUserMap[item.user.id]}}" src="{{item.user.avatarUrl}}" mode="aspectFill" data-user-id="{{item.user.id}}" binderror="onLeaderboardAvatarError" />
        <text class="leaderboard-avatar-text" wx:else>{{item.user.nickname.substring(0,1)}}</text>
      </view>
      <view class="leaderboard-main" data-user-id="{{item.user.id}}" bindtap="onOpenVisitorFromLeaderboard">
        <view class="leaderboard-name-row">
          <text class="leaderboard-name">{{item.user.nickname}}</text>
          <text class="leaderboard-self" wx:if="{{item.user.id === user.id}}">我</text>
        </view>
        <view class="leaderboard-meta">粉丝 {{item.followerCount}} · 交易 {{item.contentCount}}</view>
        <view class="leaderboard-latest">最新交易｜{{item.latestTradeText}}</view>
      </view>
      <view class="leaderboard-value">
        <text class="leaderboard-number profit-positive" wx:if="{{leaderboardActiveKey === 'profit'}}">¥{{fmt.toFixed(item.totalProfit, 2)}}</text>
        <text class="leaderboard-number" wx:if="{{leaderboardActiveKey === 'fans'}}">{{item.followerCount}}</text>
        <text class="leaderboard-number" wx:if="{{leaderboardActiveKey === 'holding'}}">{{fmt.toFixed(item.currentHolding, 2)}}g</text>
        <text class="leaderboard-label" wx:if="{{leaderboardActiveKey === 'profit'}}">累计收益</text>
        <text class="leaderboard-label" wx:if="{{leaderboardActiveKey === 'fans'}}">粉丝数</text>
        <text class="leaderboard-label" wx:if="{{leaderboardActiveKey === 'holding'}}">持有克数</text>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{visitorModalVisible}}" bindtap="onCloseVisitorModal"></view>
  <view class="visitor-modal" wx:if="{{visitorModalVisible && visitorProfile}}">
    <view class="visitor-hero">
      <view class="visitor-hero-top">
        <view class="visitor-identity">
          <view class="visitor-avatar">
            <image class="visitor-avatar-img" wx:if="{{visitorProfile.user.avatarUrl && !visitorAvatarBroken}}" src="{{visitorProfile.user.avatarUrl}}" mode="aspectFill" binderror="onVisitorAvatarError" />
            <text class="visitor-avatar-text" wx:else>{{visitorProfile.user.nickname.substring(0,1)}}</text>
          </view>
          <view class="visitor-meta">
            <text class="visitor-name">{{visitorProfile.user.nickname}}</text>
            <text class="visitor-id">ID：{{visitorProfile.user.id}}</text>
            <text class="visitor-desc">{{visitorProfile.isFollowing || visitorProfile.isSelf ? '已开放完整收益视图' : '关注后可查看整体收益'}}</text>
          </view>
        </view>
        <view class="visitor-action {{visitorProfile.isFollowing || visitorProfile.isSelf ? 'followed' : ''}}" bindtap="onFollowVisitor">
          <text class="visitor-action-text">{{visitorProfile.isSelf ? '本人' : (visitorProfile.isFollowing ? '已关注' : '关注') }}</text>
        </view>
      </view>
      <view class="visitor-stats-row">
        <view class="visitor-stat">
          <text class="visitor-stat-value">{{visitorProfile.followingCount}}</text>
          <text class="visitor-stat-label">关注</text>
        </view>
        <view class="visitor-stat">
          <text class="visitor-stat-value">{{visitorProfile.followerCount}}</text>
          <text class="visitor-stat-label">粉丝</text>
        </view>
        <view class="visitor-stat">
          <text class="visitor-stat-value">{{visitorProfile.latestTransaction ? 1 : 0}}</text>
          <text class="visitor-stat-label">最新动态</text>
        </view>
      </view>
    </view>

    <view class="visitor-summary-card">
      <view class="visitor-summary-head">
        <text class="visitor-summary-title">黄金持仓总览</text>
        <text class="visitor-summary-tip">{{visitorProfile.isFollowing || visitorProfile.isSelf ? '已开放完整数据' : '先关注再查看完整收益'}}</text>
      </view>
      <view class="visitor-total-value" wx:if="{{visitorProfile.isFollowing || visitorProfile.isSelf}}">¥{{fmt.toFixed(visitorProfile.currentValue, 2)}}</view>
      <view class="visitor-total-value" wx:else>关注后解锁</view>
      <view class="visitor-summary-grid" wx:if="{{visitorProfile.isFollowing || visitorProfile.isSelf}}">
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">成本均价</text>
          <text class="visitor-summary-value">¥{{fmt.toFixed(visitorProfile.avgCost, 2)}}</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">持有克数</text>
          <text class="visitor-summary-value">{{fmt.toFixed(visitorProfile.currentHolding, 4)}}g</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">持仓收益</text>
          <text class="visitor-summary-value {{visitorProfile.unrealizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(visitorProfile.unrealizedProfit, 2)}}</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">累计收益</text>
          <text class="visitor-summary-value {{visitorProfile.totalProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(visitorProfile.totalProfit, 2)}}</text>
        </view>
      </view>
      <view class="visitor-locked" wx:else>
        <text class="visitor-locked-text">当前仅展示主页信息与最新交易，关注后可查看整体收益。</text>
      </view>
    </view>

    <view class="visitor-latest-card">
      <text class="visitor-latest-title">最新交易</text>
      <text class="visitor-latest-value">{{visitorProfile.latestTradeText}}</text>
    </view>

    <view class="visitor-close-row">
      <button class="visitor-close-btn" bindtap="onCloseVisitorModal">关闭</button>
    </view>
  </view>

  <view class="profile-modal-mask" wx:if="{{profileModalVisible}}" bindtap="onCloseProfileModal"></view>
  <view class="profile-modal-card" wx:if="{{profileModalVisible}}">
    <view class="profile-modal-head">
      <text class="profile-title">个人信息</text>
      <text class="profile-close" bindtap="onCloseProfileModal">关闭</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">头像</text>
      <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
        <image class="profile-avatar" src="{{user.avatarUrl || '/images/logo.png'}}" mode="aspectFill" />
        <text class="profile-op">修改</text>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">ID</text>
      <view class="profile-value-wrap">
        <text class="profile-value">{{user.id}}</text>
        <view class="profile-copy-btn" bindtap="onCopyUserId">
          <image class="profile-copy-icon" src="/images/复制.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">昵称</text>
      <input class="profile-input" placeholder="请输入昵称" maxlength="20" value="{{profileNicknameDraft}}" bindinput="onProfileNicknameInput" />
    </view>
    <view class="profile-safe-actions">
      <button class="profile-save-btn" bindtap="onSaveProfileNickname" loading="{{profileSaving}}">保存昵称</button>
      <button class="profile-action-btn neutral" bindtap="onCloseProfileModal" disabled="{{profileSaving}}">关闭</button>
    </view>
  </view>
</view>
