.container { min-height: 100vh; background: #f5f5f5; padding-bottom: 100rpx; }
.header { padding: 30rpx; background: linear-gradient(135deg, #f6b73c, #f59e0b); color: #fff; }
.title { font-size: 36rpx; font-weight: 700; }
.tab-nav { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { flex:1; text-align: center; padding: 20rpx; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.tab.active { color: #f6b73c; border-bottom-color: #f6b73c; font-weight: 600; }
.list { padding: 16rpx; }
.item { display: flex; align-items: center; padding: 20rpx; background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; }
.item.myself { background: #fff8e1; border: 2rpx solid #f6b73c; }
.rank { width: 60rpx; font-size: 28rpx; font-weight: 700; color: #999; }
.avatar-wrap { width: 72rpx; height: 72rpx; border-radius: 50%; overflow: hidden; margin-right: 16rpx; background: #e0e0e0; display: flex; align-items: center; justify-content: center; }
.avatar { width: 100%; height: 100%; }
.avatar-placeholder { font-size: 28rpx; color: #999; font-weight: 700; }
.info { flex: 1; }
.nickname { display: block; font-size: 28rpx; font-weight: 600; color: #333; }
.detail { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; line-height: 1.5; }
.score { font-size: 32rpx; font-weight: 700; color: #f6b73c; }
.empty { padding: 100rpx 0; text-align: center; color: #999; font-size: 28rpx; }
.my-rank { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx; background: #fff; text-align: center; font-size: 26rpx; color: #666; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06); }
