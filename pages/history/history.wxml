<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <top-user-card
    user="{{user}}"
    bindselector="onGoSelector"
    bindwedding="onGoWedding"
    bindmessage="onGoSelector"
    bindsocial="onGoSocial"
  />

  <view class="card">
    <view class="card-title">综合筛选</view>
    <view class="filter-grid-main">
      <view class="filter-col filter-col-time">
        <text class="filter-col-title">时间</text>
        <view class="chip-group compact-group">
          <view
            class="chip-btn compact {{quickQueryKey === item.key ? 'active' : ''}}"
            wx:for="{{quickTimeOptions}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onQuickQueryTap"
          >
            <text class="chip-btn-text">{{item.label}}</text>
          </view>
        </view>
        <view class="date-row-compact">
          <picker class="date-picker-compact" mode="date" value="{{startDate}}" end="{{today}}" bindchange="onStartDateChange">
            <view class="date-picker-inner">
              <text class="date-tag">起</text>
              <text class="date-value">{{startDate || '开始日期'}}</text>
            </view>
          </picker>
          <picker class="date-picker-compact" mode="date" value="{{endDate}}" end="{{today}}" bindchange="onEndDateChange">
            <view class="date-picker-inner">
              <text class="date-tag">止</text>
              <text class="date-value">{{endDate || '结束日期'}}</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="filter-col filter-col-right filter-col-stack">
        <view class="sub-filter-block">
          <text class="filter-col-title">交易</text>
          <view class="chip-group compact-group">
            <view
              class="chip-btn compact {{quickQueryKey === item.key ? 'active' : ''}}"
              wx:for="{{quickTradeOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="onQuickQueryTap"
            >
              <text class="chip-btn-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="sub-filter-block">
          <text class="filter-col-title">平台</text>
          <view class="chip-group compact-group">
            <view
              class="chip-btn compact {{platformFilterIndex === index ? 'active' : ''}}"
              wx:for="{{platformFilters}}"
              wx:key="*this"
              data-index="{{index}}"
              bindtap="onPlatformFilterTap"
            >
              <text class="chip-btn-text">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="sub-filter-block">
          <text class="filter-col-title">类型</text>
          <view class="chip-group compact-group">
            <view
              class="chip-btn compact {{typeFilterIndex === index ? 'active' : ''}}"
              wx:for="{{typeFilters}}"
              wx:key="*this"
              data-index="{{index}}"
              bindtap="onTypeFilterTap"
            >
              <text class="chip-btn-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{showStats}}">
    <view class="card-title">统计结果</view>
    <view class="query-summary" wx:if="{{querySummary}}">{{querySummary}}</view>

    <view class="stats-dual" wx:if="{{buyStats || sellStats}}">
      <view class="stat-section dense" wx:if="{{buyStats}}">
        <view class="stat-head-row">
          <view class="stat-header with-icon">
            <text class="stat-icon buy">↗</text>
            <text>买入</text>
          </view>
          <text class="stat-mini">{{buyStats.count || 0}} 笔</text>
        </view>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="stat-label">均价</text>
            <text class="stat-value">¥{{fmt.toFixed(buyStats.avgPrice, 2)}}/克</text>
          </view>
          <view class="stat-cell">
            <text class="stat-label">总克数</text>
            <text class="stat-value">{{fmt.toFixed(buyStats.totalWeight, 2)}} 克</text>
          </view>
          <view class="stat-cell span2">
            <text class="stat-label">总金额</text>
            <text class="stat-value">¥{{fmt.toFixed(buyStats.totalAmount, 2)}}</text>
          </view>
        </view>
      </view>

      <view class="stat-section dense" wx:if="{{sellStats}}">
        <view class="stat-head-row">
          <view class="stat-header with-icon">
            <text class="stat-icon sell">↘</text>
            <text>卖出</text>
          </view>
          <text class="stat-mini">{{sellStats.count || 0}} 笔</text>
        </view>
        <view class="stat-grid">
          <view class="stat-cell">
            <text class="stat-label">均价</text>
            <text class="stat-value">¥{{fmt.toFixed(sellStats.avgPrice, 2)}}/克</text>
          </view>
          <view class="stat-cell">
            <text class="stat-label">总克数</text>
            <text class="stat-value">{{fmt.toFixed(sellStats.totalWeight, 2)}} 克</text>
          </view>
          <view class="stat-cell">
            <text class="stat-label">总金额</text>
            <text class="stat-value">¥{{fmt.toFixed(sellStats.totalAmount, 2)}}</text>
          </view>
          <view class="stat-cell" wx:if="{{sellStats.totalFee > 0}}">
            <text class="stat-label">手续费</text>
            <text class="stat-value">¥{{fmt.toFixed(sellStats.totalFee, 2)}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="no-data" wx:if="{{!buyStats && !sellStats}}">
      <text>该时段暂无交易记录</text>
    </view>

    <view class="query-record-wrap" wx:if="{{queryResultTransactions.length > 0}}">
      <view class="query-record-title">本次查询交易（{{queryResultTransactions.length}}笔）</view>

      <view class="btn-row" wx:if="{{querySelectedCount > 0 && !isGoldReadOnly}}">
        <button class="btn secondary" bindtap="clearQuerySelection">清空选择</button>
        <button class="btn" bindtap="calculateQueryCustom">计算均价</button>
      </view>

      <view class="selected-stats-wrap selected-stats-top" wx:if="{{queryCustomStats}}">
        <view class="query-record-title">本次查询选定记录统计（{{querySelectedCount}}笔）</view>
        <view class="stats-dual" wx:if="{{queryCustomStats.buy || queryCustomStats.sell}}">
          <view class="stat-section dense" wx:if="{{queryCustomStats.buy}}">
            <view class="stat-head-row">
              <view class="stat-header with-icon">
                <text class="stat-icon buy">↗</text>
                <text>买入</text>
              </view>
              <text class="stat-mini">{{queryCustomStats.buy.count || 0}} 笔</text>
            </view>
            <view class="stat-grid">
              <view class="stat-cell">
                <text class="stat-label">均价</text>
                <text class="stat-value">¥{{fmt.toFixed(queryCustomStats.buy.avgPrice, 2)}}/克</text>
              </view>
              <view class="stat-cell">
                <text class="stat-label">总克数</text>
                <text class="stat-value">{{fmt.toFixed(queryCustomStats.buy.totalWeight, 2)}} 克</text>
              </view>
              <view class="stat-cell span2">
                <text class="stat-label">总金额</text>
                <text class="stat-value">¥{{fmt.toFixed(queryCustomStats.buy.totalAmount, 2)}}</text>
              </view>
            </view>
          </view>

          <view class="stat-section dense" wx:if="{{queryCustomStats.sell}}">
            <view class="stat-head-row">
              <view class="stat-header with-icon">
                <text class="stat-icon sell">↘</text>
                <text>卖出</text>
              </view>
              <text class="stat-mini">{{queryCustomStats.sell.count || 0}} 笔</text>
            </view>
            <view class="stat-grid">
              <view class="stat-cell">
                <text class="stat-label">均价</text>
                <text class="stat-value">¥{{fmt.toFixed(queryCustomStats.sell.avgPrice, 2)}}/克</text>
              </view>
              <view class="stat-cell">
                <text class="stat-label">总克数</text>
                <text class="stat-value">{{fmt.toFixed(queryCustomStats.sell.totalWeight, 2)}} 克</text>
              </view>
              <view class="stat-cell">
                <text class="stat-label">总金额</text>
                <text class="stat-value">¥{{fmt.toFixed(queryCustomStats.sell.totalAmount, 2)}}</text>
              </view>
              <view class="stat-cell" wx:if="{{queryCustomStats.sell.totalFee > 0}}">
                <text class="stat-label">手续费</text>
                <text class="stat-value">¥{{fmt.toFixed(queryCustomStats.sell.totalFee, 2)}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="record-list">
        <view
          class="record-item {{item.selected ? 'selected' : ''}}"
          wx:for="{{queryResultTransactions}}"
          wx:key="id"
          bindtap="toggleQuerySelection"
          data-id="{{item.id}}"
        >
          <view class="record-header">
            <view class="record-left">
              <text class="record-no">#{{item.displayNo}}</text>
              <text class="record-type {{item.type === 'buy' ? 'buy' : 'sell'}}">{{item.type === 'buy' ? '买入' : '卖出'}}</text>
            </view>
            <text class="record-date">{{item.displayTime}}</text>
          </view>

          <view class="record-body">
            <view class="record-info">
              <text class="info-label">交易号</text>
              <text class="info-value">{{item.id}}</text>
            </view>
            <view class="record-info">
              <text class="info-label">平台</text>
              <text class="info-value">{{item.platform}}</text>
            </view>
            <view class="record-info">
              <text class="info-label">价格</text>
              <text class="info-value">¥{{fmt.toFixed(item.price, 2)}}</text>
            </view>
            <view class="record-info">
              <text class="info-label">克数</text>
              <text class="info-value">{{fmt.toFixed(item.weight, 2)}}g</text>
            </view>
            <view class="record-info">
              <text class="info-label">金额</text>
              <text class="info-value">¥{{fmt.toFixed(item.net_amount, 2)}}</text>
            </view>
            <view class="record-info" wx:if="{{item.fee_amount > 0}}">
              <text class="info-label">手续费</text>
              <text class="info-value">¥{{fmt.toFixed(item.fee_amount, 2)}}</text>
            </view>
          </view>

          <view class="record-actions" wx:if="{{!isGoldReadOnly}}">
            <button class="action-btn" catchtap="editTransaction" data-id="{{item.id}}">修改</button>
            <button class="action-btn danger" catchtap="deleteTransaction" data-id="{{item.id}}">删除</button>
          </view>

          <view class="record-check" wx:if="{{item.selected}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">交易总览</view>

    <view class="selected-stats-wrap selected-stats-top" wx:if="{{customStats}}">
      <view class="query-record-title">选定记录统计（{{selectedCount}}笔）</view>
      <view class="stats-dual" wx:if="{{customStats.buy || customStats.sell}}">
        <view class="stat-section dense" wx:if="{{customStats.buy}}">
          <view class="stat-head-row">
            <view class="stat-header with-icon">
              <text class="stat-icon buy">↗</text>
              <text>买入</text>
            </view>
            <text class="stat-mini">{{customStats.buy.count || 0}} 笔</text>
          </view>
          <view class="stat-grid">
            <view class="stat-cell">
              <text class="stat-label">均价</text>
              <text class="stat-value">¥{{fmt.toFixed(customStats.buy.avgPrice, 2)}}/克</text>
            </view>
            <view class="stat-cell">
              <text class="stat-label">总克数</text>
              <text class="stat-value">{{fmt.toFixed(customStats.buy.totalWeight, 2)}} 克</text>
            </view>
            <view class="stat-cell span2">
              <text class="stat-label">总金额</text>
              <text class="stat-value">¥{{fmt.toFixed(customStats.buy.totalAmount, 2)}}</text>
            </view>
          </view>
        </view>

        <view class="stat-section dense" wx:if="{{customStats.sell}}">
          <view class="stat-head-row">
            <view class="stat-header with-icon">
              <text class="stat-icon sell">↘</text>
              <text>卖出</text>
            </view>
            <text class="stat-mini">{{customStats.sell.count || 0}} 笔</text>
          </view>
          <view class="stat-grid">
            <view class="stat-cell">
              <text class="stat-label">均价</text>
              <text class="stat-value">¥{{fmt.toFixed(customStats.sell.avgPrice, 2)}}/克</text>
            </view>
            <view class="stat-cell">
              <text class="stat-label">总克数</text>
              <text class="stat-value">{{fmt.toFixed(customStats.sell.totalWeight, 2)}} 克</text>
            </view>
            <view class="stat-cell">
              <text class="stat-label">总金额</text>
              <text class="stat-value">¥{{fmt.toFixed(customStats.sell.totalAmount, 2)}}</text>
            </view>
            <view class="stat-cell" wx:if="{{customStats.sell.totalFee > 0}}">
              <text class="stat-label">手续费</text>
              <text class="stat-value">¥{{fmt.toFixed(customStats.sell.totalFee, 2)}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="record-list">
      <view
        class="record-item {{item.selected ? 'selected' : ''}}"
        wx:for="{{transactions}}"
        wx:key="id"
        bindtap="toggleSelection"
        data-id="{{item.id}}"
      >
        <view class="record-header">
          <view class="record-left">
            <text class="record-no">#{{item.displayNo}}</text>
            <text class="record-type {{item.type === 'buy' ? 'buy' : 'sell'}}">{{item.type === 'buy' ? '买入' : '卖出'}}</text>
          </view>
          <text class="record-date">{{item.displayTime}}</text>
        </view>

        <view class="record-body">
          <view class="record-info">
            <text class="info-label">交易号</text>
            <text class="info-value">{{item.id}}</text>
          </view>
          <view class="record-info">
            <text class="info-label">平台</text>
            <text class="info-value">{{item.platform}}</text>
          </view>
          <view class="record-info">
            <text class="info-label">价格</text>
            <text class="info-value">¥{{fmt.toFixed(item.price, 2)}}</text>
          </view>
          <view class="record-info">
            <text class="info-label">克数</text>
            <text class="info-value">{{fmt.toFixed(item.weight, 2)}}g</text>
          </view>
          <view class="record-info">
            <text class="info-label">金额</text>
            <text class="info-value">¥{{fmt.toFixed(item.net_amount, 2)}}</text>
          </view>
          <view class="record-info" wx:if="{{item.fee_amount > 0}}">
            <text class="info-label">手续费</text>
            <text class="info-value">¥{{fmt.toFixed(item.fee_amount, 2)}}</text>
          </view>
        </view>

        <view class="record-actions" wx:if="{{!isGoldReadOnly}}">
          <button class="action-btn" catchtap="editTransaction" data-id="{{item.id}}">修改</button>
          <button class="action-btn danger" catchtap="deleteTransaction" data-id="{{item.id}}">删除</button>
        </view>

        <view class="record-check" wx:if="{{item.selected}}">✓</view>
      </view>
    </view>
  </view>

  <view class="floating-action-bar" wx:if="{{selectedCount > 0 && !isGoldReadOnly}}">
    <button class="btn secondary" bindtap="clearSelection">清空选择</button>
    <button class="btn" bindtap="calculateCustom">计算均价</button>
  </view>

  <view class="edit-mask" wx:if="{{editVisible}}">
    <view class="edit-card">
      <view class="card-title">修改交易</view>

      <view class="form-item">
        <text class="form-label">成交价格（元/克）</text>
        <input class="form-input" type="digit" value="{{editForm.price}}" bindinput="onEditPriceInput" />
      </view>

      <view class="form-item">
        <text class="form-label">交易克数</text>
        <input class="form-input" type="digit" value="{{editForm.weight}}" bindinput="onEditWeightInput" />
      </view>

      <view class="form-item">
        <text class="form-label">交易平台</text>
        <picker class="form-picker" range="{{platforms}}" value="{{editForm.platformIndex}}" bindchange="onEditPlatformChange">
          <view class="picker">{{platforms[editForm.platformIndex]}}</view>
          <text class="picker-arrow">›</text>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">交易日期</text>
        <picker class="form-picker" mode="date" value="{{editForm.date}}" end="{{today}}" bindchange="onEditDateChange">
          <view class="unified-date-picker">
            <view class="unified-date-inner">
              <text class="unified-date-tag">日</text>
              <text class="unified-date-value">{{editForm.date || '请选择日期'}}</text>
            </view>
          </view>
        </picker>
      </view>

      <view class="btn-row">
        <button class="btn secondary" bindtap="closeEdit">取消</button>
        <button class="btn" bindtap="submitEdit">保存</button>
      </view>
    </view>
  </view>
</view>
