.container {
  padding: 20rpx;
  padding-bottom: 180rpx;
  min-height: 100vh;
  background: #f7f3ef;
}


.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 14rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.view-mode-card {
  border: 1rpx solid #efe2cb;
}

.view-mode-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.view-mode-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5f471f;
}

.view-mode-tip {
  font-size: 20rpx;
  color: #a66c22;
  background: #fbf2e3;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.view-mode-picker {
  min-height: 56rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #555;
}

.form-item {
  margin-bottom: 10rpx;
}

.form-label {
  font-size: 23rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-picker {
  width: 100%;
  height: 68rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #333;
}

.picker {
  flex: 1;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999;
  margin-left: 16rpx;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.quick-query-group {
  gap: 10rpx;
}

.filter-grid-main {
  display: flex;
  gap: 8rpx;
  align-items: start;
}

.filter-col {
  min-width: 0;
  background: #fafafa;
  border: 1rpx solid #ededed;
  border-radius: 12rpx;
  padding: 7rpx;
}

.filter-col-time {
  flex: 0 0 46%;
}

.filter-col-right {
  flex: 1;
}

.filter-col-stack {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sub-filter-block {
  background: #f7f7f7;
  border: 1rpx solid #ececec;
  border-radius: 10rpx;
  padding: 6rpx;
}

.filter-col-title {
  display: block;
  font-size: 19rpx;
  color: #8b6f43;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.compact-group {
  gap: 5rpx;
}

.date-row-compact {
  margin-top: 6rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rpx;
}

.date-picker-compact {
  height: 48rpx;
  background: #f3f3f3;
  border: 1rpx solid #e7e7e7;
  border-radius: 8rpx;
  padding: 0 7rpx;
  display: flex;
  align-items: center;
}

.date-picker-inner {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.date-tag {
  font-size: 17rpx;
  color: #9a8056;
  background: #f8ead1;
  border-radius: 6rpx;
  padding: 1rpx 5rpx;
  line-height: 1.2;
}

.date-value {
  font-size: 19rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chip-btn {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e8e8e8;
}

.chip-btn.compact {
  padding: 6rpx 10rpx;
}

.chip-btn.active {
  background: #f8ead1;
  border-color: #e4c38f;
}

.chip-btn-text {
  font-size: 20rpx;
  color: #6d532e;
}

.inline-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.inline-label {
  margin-bottom: 0;
  min-width: 120rpx;
  flex-shrink: 0;
}

.inline-chip-group {
  flex: 1;
}

.inline-picker {
  flex: 1;
  margin-top: 0;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.stat-section {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.stat-section:last-child {
  margin-bottom: 0;
}

.stat-header {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.stats-dual {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.stat-section.dense {
  margin-bottom: 0;
  padding: 12rpx;
  border: 1rpx solid #ececec;
  background: linear-gradient(180deg, #fafafa, #f6f6f6);
}

.stat-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.stat-header.with-icon {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 0;
}

.stat-icon {
  width: 26rpx;
  height: 26rpx;
  border-radius: 7rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
}

.stat-icon.buy {
  background: rgba(44, 157, 255, 0.14);
  color: #2c9dff;
}

.stat-icon.sell {
  background: rgba(255, 70, 125, 0.14);
  color: #ff467d;
}

.stat-mini {
  font-size: 20rpx;
  color: #999;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
}

.stat-cell {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 10rpx;
  padding: 8rpx;
  min-width: 0;
}

.stat-cell.span2 {
  grid-column: span 2;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.stat-value {
  margin-top: 4rpx;
  display: block;
  font-size: 23rpx;
  color: #333;
  font-weight: 600;
  word-break: break-all;
}

.no-data {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.query-summary {
  font-size: 22rpx;
  color: #8b6f43;
  background: #fbf5ea;
  border: 1rpx solid #efdeb8;
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
  margin-bottom: 12rpx;
}

.query-record-wrap {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #ececec;
}

.selected-stats-wrap {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #ececec;
}

.selected-stats-top {
  margin-top: 8rpx;
  padding-top: 0;
  border-top: none;
  margin-bottom: 10rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #ececec;
}

.query-record-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 10rpx;
}

.record-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 12rpx;
  margin-bottom: 8rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.record-item.selected {
  border-color: #d9953f;
  background: linear-gradient(135deg, rgba(239, 195, 121, 0.14), rgba(217, 149, 63, 0.05));
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.record-no {
  font-size: 22rpx;
  color: #999;
}

.record-type {
  font-size: 24rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.record-type.buy {
  color: #ff5252;
  background: rgba(255, 82, 82, 0.1);
}

.record-type.sell {
  color: #4caf50;
  background: rgba(76, 175, 80, 0.1);
}

.record-date {
  font-size: 20rpx;
  color: #999;
}

.record-body {
  display: flex;
  justify-content: space-between;
}

.record-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 10rpx;
}

.action-btn {
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  border: none;
  background: #ececec;
  color: #666;
}

.action-btn.danger {
  background: rgba(255, 82, 82, 0.12);
  color: #ff5252;
}

.info-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 3rpx;
}

.info-value {
  font-size: 23rpx;
  color: #333;
  font-weight: 500;
}

.record-check {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 36rpx;
  height: 36rpx;
  background: #d9953f;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.floating-action-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #f0e2cc;
  border-radius: 999rpx;
  padding: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.floating-action-bar .btn {
  margin: 0;
}

.btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #efc379, #d9953f);
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
}

.btn.mini {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 22rpx;
  width: 240rpx;
}

.btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn.secondary {
  background: #e0e0e0;
  color: #666;
}

.edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99;
}

.edit-card {
  width: 88%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 880;
}

.profile-modal-card {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.28);
  z-index: 881;
}

.profile-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.profile-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.profile-close {
  font-size: 22rpx;
  color: #64748b;
}

.profile-row {
  margin-bottom: 10rpx;
}

.profile-label {
  display: block;
  margin-bottom: 6rpx;
  color: #475569;
  font-size: 22rpx;
}

.profile-avatar-wrap,
.profile-value-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-op {
  color: #0369a1;
  font-size: 21rpx;
}

.profile-value {
  flex: 1;
  color: #334155;
  font-size: 22rpx;
  word-break: break-all;
}

.profile-copy-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe7f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-copy-icon {
  width: 28rpx;
  height: 28rpx;
}

.profile-input {
  width: 100%;
  height: 78rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.profile-safe-actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-save-btn,
.profile-action-btn {
  width: 100%;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.profile-save-btn {
  border: 1rpx solid #a5f3fc;
  background: #ecfeff;
  color: #0e7490;
}

.profile-danger-zone {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #f5d0d8;
}

.profile-danger-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  color: #be123c;
}

.profile-action-row {
  display: flex;
  gap: 10rpx;
}

.profile-action-btn {
  flex: 1;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.profile-action-btn.neutral {
  border: 1rpx solid #e2e8f0;
  background: #f1f5f9;
  color: #334155;
}

.profile-action-btn.danger {
  background: #ffe4e6;
  color: #9f1239;
  border-color: #fecdd3;
}

.profile-action-btn.warn {
  background: #fff7ed;
  color: #b45309;
  border-color: #fed7aa;
}