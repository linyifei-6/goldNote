<view class="container">
  <top-user-card
    user="{{user}}"
    show-message-badge="{{true}}"
    unread-message-count="{{unreadMessageCount}}"
    bindavatar="onGoSelector"
    bindopenselector="onGoSelector"
    bindopenmessage="onOpenMessageCenter"
    bindsocial="onGoSocial"
  />

  <view class="card">
    <view class="card-title">减肥目标（运动笔记子页）</view>
    <view class="field">
      <text class="label">目标体重(kg)</text>
      <input class="input" type="number" value="{{target.targetWeight}}" data-field="targetWeight" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">目标日期</text>
      <picker mode="date" value="{{target.targetEndDate}}" bindchange="onTargetDateChange">
        <view class="unified-date-picker {{target.targetEndDate ? '' : 'muted'}}">
          <view class="unified-date-inner">
            <text class="unified-date-tag">目标</text>
            <text class="unified-date-value">{{target.targetEndDate || '请选择目标日期'}}</text>
          </view>
        </view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="card-title">新增体重记录</view>
    <view class="field">
      <text class="label">记录日期</text>
      <picker mode="date" value="{{form.recordDate}}" bindchange="onRecordDateChange">
        <view class="unified-date-picker">
          <view class="unified-date-inner">
            <text class="unified-date-tag">记录</text>
            <text class="unified-date-value">{{form.recordDate}}</text>
          </view>
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">体重(kg)</text>
      <input class="input" type="number" value="{{form.weight}}" data-field="weight" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">体脂(%)</text>
      <input class="input" type="number" value="{{form.bodyFat}}" data-field="bodyFat" bindinput="onInput" />
    </view>
    <button class="save-btn" bindtap="onSubmit">保存记录</button>
  </view>

  <view class="card">
    <view class="card-title">最近记录</view>
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-row">
        <view class="record-main">
          <text>{{item.recordDate}}</text>
          <text class="record-sub">体重 {{item.weight}} kg{{item.bodyFat ? (' · 体脂 ' + item.bodyFat + '%') : ''}}</text>
        </view>
        <view class="record-del" data-id="{{item.id}}" bindtap="onDeleteRecord">删除</view>
      </view>
    </block>
  </view>

  <note-bottom-nav items="{{workoutSubTabs}}" active-key="{{currentSubTab}}" mode="fixed" bindchange="onSwitchSubTab" />
</view>
