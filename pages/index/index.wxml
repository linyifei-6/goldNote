<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <top-user-card
    user="{{goldViewDisplayUser || user}}"
    show-message-badge="{{true}}"
    unread-message-count="{{unreadMessageCount}}"
    bindavatar="onOpenProfileModal"
    bindopenselector="onGoSelector"
    bindwedding="onGoWedding"
    bindopenmessage="onOpenMessageCenter"
    bindsocial="onGoSocial"
  />

  <view class="gold-view-banner" wx:if="{{isGoldReadOnly}}">
    <text class="gold-view-text">正在查看用户：{{goldViewTargetName}}</text>
    <button class="gold-view-btn" bindtap="onReturnToMyHome">返回我的主页</button>
  </view>

  <view class="summary-card">
    <view class="summary-title">持仓总览</view>
    <view class="summary-sub">总持仓 + 收益 + 分平台</view>

    <view class="summary-body">
      <view class="summary-left">
        <view class="holding-main">
          <view class="holding-weight">{{fmt.toFixed(holdings.currentHolding, 4)}}</view>
          <view class="holding-unit">克</view>
        </view>

        <view class="kpi-row">
          <view class="kpi-item">
            <view class="kpi-head">
              <text class="kpi-label">成本均价</text>
            </view>
            <text class="kpi-value">¥{{fmt.toFixed(holdings.avgCost, 2)}}</text>
          </view>
          <view class="kpi-item">
            <view class="kpi-head">
              <text class="kpi-label">持仓收益</text>
            </view>
            <text class="kpi-value {{fmt.needSmall(unrealizedProfit) ? 'small-number' : ''}} {{unrealizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.formatCompact(unrealizedProfit, 2)}}</text>
          </view>
          <view class="kpi-item">
            <view class="kpi-head">
              <text class="kpi-label">收益率</text>
            </view>
            <text class="kpi-value {{totalReturnRate >= 0 ? 'profit-positive' : 'profit-negative'}}">{{fmt.toFixed(totalReturnRate, 2)}}%</text>
          </view>
          <view class="kpi-item">
            <view class="kpi-head">
              <text class="kpi-label">累计收益</text>
            </view>
            <text class="kpi-value {{totalProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(totalProfit, 2)}}</text>
          </view>
        </view>
      </view>

      <view class="summary-right">
        <view class="platform-mini-title">分平台持仓/收益</view>
        <view class="platform-mini-empty" wx:if="{{summaryPlatforms.length === 0}}">暂无平台数据</view>
        <view class="platform-mini-item" wx:for="{{summaryPlatforms}}" wx:key="platform">
          <view class="mini-platform-head">
            <text class="mini-platform-name">{{item.platform}}</text>
          </view>
          <view class="mini-platform-line">
            <view class="mini-line-left">
              <text class="mini-line-tag">仓</text>
              <text class="mini-line-meta">{{fmt.toFixed(item.currentHolding, 2)}}g</text>
            </view>
            <view class="mini-line-value-wrap">
              <text class="mini-line-value {{item.unrealizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}} mini-line-value-tight">¥{{fmt.toFixed(item.unrealizedProfit, 2)}}</text>
              <text class="mini-line-tag">持</text>
            </view>
          </view>
          <view class="mini-platform-line">
            <view class="mini-line-left">
              <text class="mini-line-tag">均</text>
              <text class="mini-line-meta">¥{{fmt.toFixed(item.avgCost, 2)}}</text>
            </view>
            <view class="mini-line-value-wrap">
              <text class="mini-line-value {{item.realizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}} mini-line-value-tight">¥{{fmt.toFixed(item.realizedProfit, 2)}}</text>
              <text class="mini-line-tag">累</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="holding-foot">
      <text>总投入 ¥{{fmt.toFixed(holdings.totalInvestment, 2)}}</text>
      <text>持仓市值 ¥{{fmt.toFixed(currentValue, 2)}}</text>
    </view>
  </view>

  <view class="card price-card">
    <view class="card-title-row">
      <view class="price-title-wrap">
        <view class="card-title">模拟金价</view>
        <text class="price-last-manual" wx:if="{{lastManualPrice}}" bindtap="onUseLastManualPrice">上次手动 ¥{{lastManualPrice}}（点击应用）</text>
      </view>
      <text class="update-status" wx:if="{{lastUpdateTime && autoUpdateMode}}">{{lastUpdateTime}}</text>
    </view>

    <view wx:if="{{autoUpdateMode}}">
      <view class="quote-strip">
        <view class="quote-left">
          <view class="price-main compact-main">
            <text class="price-value compact-price">{{currentPrice ? '¥' + currentPrice : '--'}}</text>
            <text class="price-unit">/克</text>
            <text class="updating-icon" wx:if="{{isUpdating}}">...</text>
          </view>
          <view class="quote-meta-line">
            <text class="quote-meta">{{priceSource || '加载中'}}</text>
            <text class="quote-dot">·</text>
            <text class="quote-meta">{{countdown}}s</text>
            <text class="quote-dot" wx:if="{{internationalPrice}}">·</text>
            <text class="quote-meta" wx:if="{{internationalPrice}}">{{internationalPrice}}</text>
          </view>
        </view>
        <view class="quote-actions">
          <view class="quote-btn" bindtap="onToggleSimulatorUpdate">
            <text class="quote-btn-text">{{simulatorPaused ? '开始' : '暂停'}}</text>
          </view>
          <view class="quote-btn" bindtap="togglePriceMode">
            <text class="quote-btn-text">手动</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else>
      <view class="manual-strip">
        <view class="manual-left">
          <view class="price-main compact-main manual-main">
            <view class="manual-price-box">
              <text class="manual-currency">¥</text>
              <input class="manual-price-input" type="digit" placeholder="--" value="{{currentPrice}}" bindinput="onPriceInput" />
            </view>
            <text class="price-unit">/克</text>
          </view>
        </view>
        <view class="manual-actions">
          <view class="quote-btn" bindtap="onManualPriceConfirm">
            <text class="quote-btn-text">确认</text>
          </view>
          <view class="quote-btn quote-btn-disabled">
            <text class="quote-btn-text quote-btn-text-disabled">开始</text>
          </view>
          <view class="quote-btn quote-btn-active">
            <text class="quote-btn-text quote-btn-text-active">手动</text>
          </view>
          <view class="quote-btn" bindtap="togglePriceMode">
            <text class="quote-btn-text">自动</text>
          </view>
        </view>
      </view>
      <view class="manual-meta">手动输入</view>
      <view class="tip">持仓收益依赖当前市价，未输入时默认为0</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title-row">
      <view class="card-title">累计收益曲线</view>
      <view class="curve-hint" bindtap="onOpenTrendDetail">趋势视图</view>
    </view>
    <view class="curve-metrics">
      <text class="metric-item">持仓收益：¥{{fmt.toFixed(unrealizedProfit, 2)}}</text>
      <text class="metric-item">持有均价：¥{{fmt.toFixed(holdings.avgCost, 2)}}/克</text>
      <text class="metric-item">当前金价：{{currentPrice ? ('¥' + currentPrice + '/克') : '--'}}</text>
    </view>
    <canvas canvas-id="cumulativeProfitCanvas" class="curve-canvas" style="width: 680rpx; height: 320rpx;" />
    <view class="curve-controls">
      <view class="form-item control-item">
        <text class="form-label">查看范围</text>
        <view class="chip-group">
          <view
            class="chip-btn {{curvePlatformIndex === index ? 'active' : ''}}"
            wx:for="{{platforms}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="onCurvePlatformTap"
          >
            <text class="chip-btn-text">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="form-item control-item" style="margin-bottom: 0;">
        <text class="form-label">时间范围</text>
        <view class="chip-group">
          <view
            class="chip-btn {{curveRangeIndex === index ? 'active' : ''}}"
            wx:for="{{curveRanges}}"
            wx:key="*this"
            data-index="{{index}}"
            bindtap="onCurveRangeTap"
          >
            <text class="chip-btn-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="trend-detail-mask" wx:if="{{showTrendDetail}}" bindtap="onCloseTrendDetail">
    <view class="trend-detail-panel" catchtap="noop">
      <view class="trend-detail-head">
        <text class="trend-detail-title">趋势视图（详细）</text>
        <text class="trend-detail-close" bindtap="onCloseTrendDetail">关闭</text>
      </view>
      <view class="trend-detail-ranges">
        <view
          class="trend-range-chip {{trendDetailRangeIndex === index ? 'active' : ''}}"
          wx:for="{{trendDetailRangeOptions}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onTrendDetailRangeTap"
        >
          <text class="trend-range-text">{{item}}</text>
        </view>
      </view>
      <canvas canvas-id="trendDetailCanvas" class="trend-detail-canvas" style="width: 720rpx; height: 520rpx;" />
    </view>
  </view>

  <view class="modal-mask" wx:if="{{profileModalVisible}}" bindtap="onCloseProfileModal"></view>
  <view class="modal-card profile-modal-card" wx:if="{{profileModalVisible}}">
    <view class="profile-modal-head">
      <text class="section-title">个人信息</text>
      <text class="profile-close" bindtap="onCloseProfileModal">关闭</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">头像</text>
      <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
        <image class="profile-avatar" src="{{user.avatarUrl || '/images/主页.png'}}" mode="aspectFill" />
        <text class="profile-op">修改</text>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">ID</text>
      <view class="profile-value-wrap">
        <text class="profile-value id">{{user.id}}</text>
        <view class="profile-copy-btn" bindtap="onCopyUserId">
          <image class="profile-copy-icon" src="/images/复制.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">昵称</text>
      <input class="form-input profile-input" maxlength="20" value="{{profileNicknameDraft}}" bindinput="onProfileNicknameInput" placeholder="请输入昵称" />
    </view>
    <view class="profile-safe-actions">
      <button class="profile-save-btn" bindtap="onSaveProfileNickname" loading="{{profileSaving}}" disabled="{{profileSaving}}">保存昵称</button>
      <button class="profile-action-btn neutral" bindtap="onCloseProfileModal" disabled="{{profileSaving}}">关闭</button>
    </view>
  </view>

</view>
