.container {
  min-height: 100vh;
  padding: 20rpx;
  background: #f7f3ef;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 998;
}

.modal-card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 18%;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 16rpx;
  z-index: 999;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.2);
}

.profile-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.profile-close {
  font-size: 21rpx;
  color: #6b7280;
}

.profile-close-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -6rpx;
  margin-bottom: 6rpx;
}

.profile-row {
  margin-bottom: 10rpx;
}

.profile-label {
  display: block;
  margin-bottom: 4rpx;
  color: #475569;
  font-size: 20rpx;
}

.profile-value-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-value {
  flex: 1;
  color: #334155;
  font-size: 22rpx;
}

.profile-value.id {
  word-break: break-all;
}

.profile-input {
  margin-bottom: 0;
  flex: 1;
}

.profile-op {
  color: #0369a1;
  font-size: 21rpx;
}

.profile-op.save {
  color: #c2410c;
}

.profile-copy-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe7f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-copy-icon {
  width: 28rpx;
  height: 28rpx;
}

.profile-avatar-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-btn-row {
  margin-top: 6rpx;
  display: flex;
  gap: 8rpx;
}

.profile-safe-actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-save-btn {
  width: 100%;
  min-height: 82rpx;
  line-height: 82rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #a5f3fc;
  background: #ecfeff;
  color: #0e7490;
}

.profile-action-grid {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-action-row {
  display: flex;
  gap: 10rpx;
}

.profile-action-row.single {
  justify-content: center;
}

.profile-action-btn {
  flex: 1;
  min-height: 68rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 68rpx;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.profile-action-btn.danger {
  background: #ffe4e6;
  color: #9f1239;
  border-color: #fecdd3;
}

.profile-action-btn.warn {
  background: #fff7ed;
  color: #b45309;
  border-color: #fed7aa;
}

.profile-action-btn.neutral {
  flex: 0 0 56%;
  width: 100%;
  background: #f1f5f9;
  color: #334155;
  border-color: #e2e8f0;
}

.profile-mini-btn {
  min-width: 88rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  color: #475569;
  font-size: 20rpx;
}

.profile-mini-btn.confirm {
  border-color: #f2c2db;
  background: #fde9f3;
  color: #9d4b73;
}

.user-quick-icon {
  width: 42rpx;
  height: 42rpx;
}

.user-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.user-tip {
  font-size: 22rpx;
  color: #999;
}

.summary-card {
  background: linear-gradient(145deg, #f8f1e5 0%, #efe3cf 100%);
  border-radius: 22rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(104, 76, 35, 0.13);
}

.summary-top {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.summary-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #3b2a13;
}

.summary-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #8a734e;
}

.scene-btn {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #ead9bf;
  color: #7d5e2e;
  font-size: 20rpx;
}

.summary-body {
  margin-top: 6rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  align-items: start;
}

.summary-left {
  min-width: 0;
}

.summary-right {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 16rpx;
  padding: 8rpx 10rpx 8rpx;
  margin-top: -76rpx;
}

.summary-right .platform-mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7c623b;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.summary-right .platform-mini-item {
  padding: 0 0 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx dashed #e3d5bf;
}

.summary-right .platform-mini-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 2rpx;
}

.summary-right .mini-platform-head {
  margin-bottom: 6rpx;
}

.summary-right .mini-platform-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3e3120;
}

.summary-right .mini-platform-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.summary-right .mini-line-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.mini-line-tag {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #efe7d7;
  color: #8b6f43;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.summary-right .mini-line-meta {
  font-size: 22rpx;
  color: #7f6440;
  white-space: nowrap;
}

.summary-right .mini-line-value {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

.summary-right .mini-line-value-tight {
  line-height: 1.1;
}

.summary-right .mini-line-value-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.mini-platform-left {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.mini-platform-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.mini-platform-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
}

.mini-platform-avg {
  font-size: 21rpx;
  color: #9a8056;
}

.platform-mini-empty {
  font-size: 22rpx;
  color: #999;
  padding: 6rpx 0;
}

.holding-main {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.holding-weight {
  font-size: 68rpx;
  line-height: 1;
  font-weight: 800;
  color: #16222e;
}

.holding-unit {
  font-size: 26rpx;
  color: #6e5a3d;
}

.kpi-row {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  column-gap: 8rpx;
  row-gap: 14rpx;
  height: 258rpx;
}

.kpi-item {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 12rpx;
  padding: 10rpx 10rpx 12rpx;
  min-height: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.kpi-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.kpi-label {
  font-size: 20rpx;
  color: #8a734e;
  white-space: nowrap;
}

.kpi-value {
  margin-top: 4rpx;
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #18212b;
  line-height: 1.12;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.holding-foot {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #745f3f;
  white-space: nowrap;
  gap: 12rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.price-card {
  border: 1rpx solid #f2e4cd;
  padding: 14rpx 16rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.curve-hint {
  font-size: 24rpx;
  color: #9b9b9b;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.trend-detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 24rpx;
}

.trend-detail-panel {
  width: 720rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.2);
  padding: 18rpx 16rpx 12rpx;
}

.trend-detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.trend-detail-ranges {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.trend-range-chip {
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e2e2e2;
}

.trend-range-chip.active {
  background: #f6ead5;
  border-color: #e8c48c;
}

.trend-range-text {
  font-size: 22rpx;
  color: #7c5e2f;
}

.trend-detail-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d2d2d;
}

.trend-detail-close {
  font-size: 24rpx;
  color: #8b6f43;
  background: #f6efe3;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
}

.trend-detail-canvas {
  border-radius: 12rpx;
  background: #fff;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2e2e2e;
  margin-bottom: 8rpx;
}

.update-status {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.price-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 12rpx;
}

.price-display.compact {
  padding: 2rpx 0 6rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d2d2d;
}

.compact-price {
  font-size: 34rpx;
}

.compact-main {
  align-items: center;
}

.quote-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 8rpx 0;
}

.quote-left {
  flex: 1;
  min-width: 0;
}

.quote-meta-line {
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  white-space: nowrap;
}

.quote-meta {
  font-size: 18rpx;
  color: #8d8d8d;
}

.quote-dot {
  font-size: 16rpx;
  color: #b5b5b5;
}

.quote-actions {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.manual-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 8rpx 0 2rpx;
}

.manual-left {
  flex: 1;
  min-width: 0;
}

.manual-main {
  align-items: center;
}

.manual-price-box {
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e8e8e8;
}

.manual-currency {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  line-height: 1;
}

.manual-price-input {
  width: 170rpx;
  height: 52rpx;
  margin-left: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #222;
}

.manual-actions {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.manual-meta {
  font-size: 18rpx;
  color: #8d8d8d;
  margin-top: 4rpx;
}

.quote-btn {
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e8e8e8;
}

.quote-btn-disabled {
  background: #f4f4f4;
  border-color: #ededed;
}

.quote-btn-active {
  background: #f8ead1;
  border-color: #e1b56f;
}

.quote-btn-text {
  font-size: 19rpx;
  color: #6d532e;
}

.quote-btn-text-disabled {
  color: #c1c1c1;
}

.quote-btn-text-active {
  color: #7c5726;
}

.price-unit {
  font-size: 24rpx;
  color: #666;
  margin-left: 6rpx;
}

.price-detail {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.international-price,
.exchange-rate {
  font-size: 20rpx;
  color: #888;
}

.fx-meta {
  font-size: 18rpx;
  color: #b3b3b3;
}

.updating-icon {
  font-size: 36rpx;
  color: #d9953f;
  margin-left: 8rpx;
  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

.price-source {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0;
  flex-wrap: wrap;
}

.source-label {
  font-size: 24rpx;
  color: #999;
}

.source-value {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

.source-value.real {
  color: #df4d2a;
}

.source-value.simulator {
  color: #d9953f;
}

.config-btn {
  font-size: 22rpx;
  color: #8b5e24;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  background: #f8ead1;
  border-radius: 6rpx;
}

.refresh-status {
  margin-top: 4rpx;
  text-align: center;
  font-size: 22rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.refresh-status.running {
  color: #9f6b2a;
  background: #fff5e8;
}

.action-row {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.action-row.compact {
  gap: 8rpx;
}

.mode-switch {
  margin-top: 6rpx;
  text-align: center;
  padding: 8rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}

.switch-text {
  font-size: 21rpx;
  color: #6d532e;
}

.mode-switch:active,
.config-btn:active,
.scene-btn:active {
  opacity: 0.72;
}

.tip {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.form-item {
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.metric-grid {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.metric-box {
  background: #f8f8f8;
  border-radius: 14rpx;
  padding: 14rpx;
}

.metric-name {
  font-size: 22rpx;
  color: #808080;
}

.metric-value {
  margin-top: 4rpx;
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
}

.return-rate {
  font-size: 30rpx;
  font-weight: 700;
}

.platform-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.platform-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.platform-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.platform-row.multi {
  display: block;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #f2f2f2;
}

.platform-row.multi:last-child {
  border-bottom: none;
}

.platform-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.platform-subline {
  margin-top: 6rpx;
  display: flex;
  justify-content: space-between;
  color: #999;
  font-size: 22rpx;
}

.platform-name {
  font-size: 24rpx;
  color: #333;
}

.platform-value {
  font-size: 22rpx;
  color: #555;
}

.profit-positive {
  color: #ff5252;
}

.profit-negative {
  color: #4caf50;
}

.curve-hint {
  font-size: 22rpx;
  color: #9b9b9b;
}

.curve-canvas {
  width: 680rpx;
  height: 320rpx;
  background: #fcfcfc;
  border-radius: 10rpx;
}

.curve-metrics {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.metric-item {
  flex: 1;
  min-width: 200rpx;
  font-size: 22rpx;
  color: #666;
  background: #f4f4f4;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
}

.curve-controls {
  margin-top: 12rpx;
}

.control-item {
  margin-bottom: 12rpx;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.chip-btn {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e8e8e8;
}

.chip-btn.active {
  background: #f8ead1;
  border-color: #e4c38f;
}

.chip-btn-text {
  font-size: 22rpx;
  color: #6d532e;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999;
  margin-left: 16rpx;
}
