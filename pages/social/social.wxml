<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 'mutual' ? 'active' : ''}}" data-tab="mutual" bindtap="onTabTap">互关</view>
    <view class="tab {{activeTab === 'following' ? 'active' : ''}}" data-tab="following" bindtap="onTabTap">关注</view>
    <view class="tab {{activeTab === 'followers' ? 'active' : ''}}" data-tab="followers" bindtap="onTabTap">粉丝</view>
  </view>

  <view class="search-wrap">
    <input class="search-input" placeholder="搜索用户昵称或ID" value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <!-- 搜索模式：全局搜索结果 -->
  <view wx:if="{{searchKeyword}}">
    <view class="list-wrap" wx:if="{{searchResults.length > 0}}">
      <view class="user-item" wx:for="{{searchResults}}" wx:key="userId">
        <view class="avatar-wrap">
          <image class="avatar" src="{{item.avatarUrl || '/images/logo.png'}}" mode="aspectFill" data-user-id="{{item.userId}}" bindtap="onAvatarTap" />
          <view
            class="follow-toggle {{item.toggleClass}}"
            data-action="{{item.toggleAction}}"
            data-relation-id="{{item.relationId}}"
            data-user-id="{{item.userId}}"
            catchtap="onToggleFollow"
          >{{item.toggleText}}</view>
        </view>
        <view class="user-main" data-user-id="{{item.userId}}" data-user-name="{{item.nickname}}" bindtap="onStartChat">
          <view class="line-top">
            <text class="name">{{item.nickname}}</text>
            <text class="time">{{item.lastChatTime || ''}}</text>
          </view>
          <view class="line-bottom">
            <text class="preview">{{item.lastChatPreview}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>没有找到匹配用户</view>
  </view>

  <!-- 常规模式：当前 tab 列表 -->
  <view wx:else>
    <view class="list-wrap" wx:if="{{displayList.length > 0}}">
      <view class="user-item" wx:for="{{displayList}}" wx:key="uid">
        <view class="avatar-wrap">
          <image class="avatar" src="{{item.avatarUrl || '/images/logo.png'}}" mode="aspectFill" data-user-id="{{item.userId}}" bindtap="onAvatarTap" />
          <view
            class="follow-toggle {{item.toggleClass}}"
            data-action="{{item.toggleAction}}"
            data-relation-id="{{item.relationId}}"
            data-user-id="{{item.userId}}"
            catchtap="onToggleFollow"
          >{{item.toggleText}}</view>
        </view>
        <view class="user-main" data-user-id="{{item.userId}}" data-user-name="{{item.nickname}}" bindtap="onStartChat">
          <view class="line-top">
            <text class="name">{{item.nickname}}</text>
            <text class="time">{{item.lastChatTime || ''}}</text>
          </view>
          <view class="line-bottom">
            <text class="preview">{{item.lastChatPreview}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>{{emptyText}}</view>
  </view>

  <!-- 访客主页弹层 -->
  <view class="modal-mask" wx:if="{{visitorModalVisible}}" bindtap="onCloseVisitorModal" catchtouchmove="noop"></view>
  <view class="visitor-modal" wx:if="{{visitorModalVisible && visitorProfile}}" catchtouchmove="noop">
    <view class="visitor-top-bar" wx:if="{{visitorProfile}}">
      <text class="visitor-top-text">当前浏览用户：{{visitorProfile.user.nickname}}</text>
      <button class="visitor-return-btn" bindtap="onReturnToMyHome">返回我的主页</button>
    </view>
    <scroll-view class="visitor-modal-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="visitor-hero">
      <view class="visitor-hero-top">
        <view class="visitor-identity">
          <view class="visitor-avatar-wrap">
            <image class="visitor-avatar-img" wx:if="{{visitorProfile.user.avatarUrl}}" src="{{visitorProfile.user.avatarUrl}}" mode="aspectFill" />
            <text class="visitor-avatar-text" wx:else>{{visitorProfile.user.nickname.substring(0,1)}}</text>
          </view>
          <view class="visitor-meta">
            <text class="visitor-name">{{visitorProfile.user.nickname}}</text>
            <text class="visitor-id">ID：{{visitorProfile.user.id}}</text>
            <text class="visitor-desc">{{visitorProfile.isFollowing || visitorProfile.isSelf ? '已开放完整收益视图' : '关注后可查看整体收益'}}</text>
          </view>
        </view>
        <view class="visitor-action {{visitorProfile.isFollowing || visitorProfile.isSelf ? 'followed' : ''}}" bindtap="onFollowVisitor">
          <text class="visitor-action-text">{{visitorProfile.isSelf ? '本人' : (visitorProfile.isFollowing ? '已关注' : '关注')}}</text>
        </view>
      </view>
        <view class="visitor-stat">
          <text class="visitor-stat-value">{{visitorProfile.followingCount}}</text>
          <text class="visitor-stat-label">关注</text>
        </view>
        <view class="visitor-stat">
          <text class="visitor-stat-value">{{visitorProfile.followerCount}}</text>
          <text class="visitor-stat-label">粉丝</text>
        </view>
    </view>

    <view class="visitor-summary-card">
      <view class="visitor-summary-head">
        <text class="visitor-summary-title">黄金持仓总览</text>
        <text class="visitor-summary-tip">{{visitorProfile.isFollowing || visitorProfile.isSelf ? '完整数据' : '关注后解锁'}}</text>
      </view>
      <view class="visitor-total-value" wx:if="{{visitorProfile.isFollowing || visitorProfile.isSelf}}">¥{{fmt.toFixed(visitorProfile.currentValue, 2)}}</view>
      <view class="visitor-total-value locked-hint" wx:else>关注后解锁</view>
      <view class="visitor-summary-grid" wx:if="{{visitorProfile.isFollowing || visitorProfile.isSelf}}">
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">成本均价</text>
          <text class="visitor-summary-value">¥{{fmt.toFixed(visitorProfile.avgCost, 2)}}</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">持有克数</text>
          <text class="visitor-summary-value">{{fmt.toFixed(visitorProfile.currentHolding, 4)}}g</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">持仓收益</text>
          <text class="visitor-summary-value {{visitorProfile.unrealizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(visitorProfile.unrealizedProfit, 2)}}</text>
        </view>
        <view class="visitor-summary-item">
          <text class="visitor-summary-label">累计收益</text>
          <text class="visitor-summary-value {{visitorProfile.totalProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(visitorProfile.totalProfit, 2)}}</text>
        </view>
      </view>
      <view class="visitor-actions" wx:if="{{visitorProfile.isFollowing || visitorProfile.isSelf}}">
        <button class="visitor-action-btn" bindtap="onViewVisitorHistory">查看历史记录</button>
      </view>
      <view class="visitor-locked" wx:else>
        <text class="visitor-locked-text">当前仅展示主页信息，关注后可查看整体收益。</text>
      </view>
    </view>

    <view class="visitor-platform-card" wx:if="{{(visitorProfile.isFollowing || visitorProfile.isSelf) && visitorProfile.platformSummary && visitorProfile.platformSummary.length > 0}}">
      <view class="visitor-platform-title">分平台持仓/收益</view>
      <view class="visitor-platform-item" wx:for="{{visitorProfile.platformSummary}}" wx:key="platform">
        <text class="visitor-platform-name">{{item.platform}}</text>
        <view class="visitor-platform-line">
          <view class="visitor-platform-meta-wrap">
            <text class="visitor-platform-tag">仓</text>
            <text class="visitor-platform-meta">{{fmt.toFixed(item.currentHolding, 2)}}g</text>
          </view>
          <view class="visitor-platform-value-wrap">
            <text class="visitor-platform-value {{item.unrealizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(item.unrealizedProfit, 2)}}</text>
            <text class="visitor-platform-tag">持</text>
          </view>
        </view>
        <view class="visitor-platform-line">
          <view class="visitor-platform-meta-wrap">
            <text class="visitor-platform-tag">均</text>
            <text class="visitor-platform-meta">¥{{fmt.toFixed(item.avgCost, 2)}}</text>
          </view>
          <view class="visitor-platform-value-wrap">
            <text class="visitor-platform-value {{item.realizedProfit >= 0 ? 'profit-positive' : 'profit-negative'}}">¥{{fmt.toFixed(item.realizedProfit, 2)}}</text>
            <text class="visitor-platform-tag">累</text>
          </view>
        </view>
      </view>
    </view>

    <view class="visitor-latest-card">
      <text class="visitor-latest-title">最新交易</text>
      <text class="visitor-latest-value">{{visitorProfile.latestTradeText}}</text>
    </view>

    <view class="visitor-close-row">
      <button class="visitor-close-btn" bindtap="onCloseVisitorModal">关闭</button>
    </view>
    </scroll-view>
  </view>
</view>
