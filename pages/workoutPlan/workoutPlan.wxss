.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #dcfce7;
  padding: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #065f46;
  margin-bottom: 14rpx;
}

.progress-box {
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  padding: 14rpx;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  color: #0f766e;
  font-size: 22rpx;
}

.progress-value {
  font-weight: 700;
}

.progress-track {
  margin-top: 8rpx;
  width: 100%;
  height: 12rpx;
  background: #d1fae5;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 12rpx;
  background: linear-gradient(90deg, #34d399, #10b981);
}

.progress-desc {
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 20rpx;
}

.field {
  margin-bottom: 12rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.input {
  width: 100%;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 14rpx;
  background: #10b981;
  color: #ffffff;
  border-radius: 14rpx;
}

.quick-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quick-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
  color: #64748b;
  font-size: 22rpx;
}

.quick-chip.active {
  color: #0f766e;
  border-color: #5eead4;
  background: #f0fdfa;
  font-weight: 600;
}

.template-panel {
  margin-top: 12rpx;
  border: 1rpx solid #dbeafe;
  background: #f8fbff;
  border-radius: 14rpx;
  padding: 14rpx;
}

.template-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.template-title {
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 700;
}

.template-summary {
  color: #475569;
  font-size: 20rpx;
}

.template-field {
  margin-top: 10rpx;
}

.template-label {
  display: block;
  color: #475569;
  font-size: 20rpx;
  margin-bottom: 6rpx;
}

.template-add-btn {
  margin-top: 12rpx;
  background: #dbeafe;
  color: #1d4ed8;
  border: 1rpx solid #93c5fd;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.template-list {
  margin-top: 12rpx;
}

.template-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.template-item-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.template-item-title {
  color: #0f172a;
  font-size: 24rpx;
}

.template-item-sub {
  color: #64748b;
  font-size: 20rpx;
}

.template-item-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.template-toggle,
.template-delete {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.template-toggle {
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  background: #f0fdfa;
}

.template-toggle.done {
  color: #92400e;
  border-color: #fcd34d;
  background: #fef3c7;
}

.template-delete {
  color: #dc2626;
  border: 1rpx solid #fecaca;
  background: #fef2f2;
}

.template-empty {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
}
