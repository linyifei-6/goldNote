.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tab {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 14rpx;
  color: #666;
  font-size: 28rpx;
}

.tab.active {
  color: #d18a00;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  right: 14rpx;
  top: 8rpx;
  min-width: 34rpx;
  padding: 0 10rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #fff;
  background: #f05050;
  font-size: 20rpx;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty {
  color: #8b8b8b;
  text-align: center;
  font-size: 26rpx;
  padding: 48rpx 20rpx;
}

.empty.small {
  padding: 24rpx 20rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 600;
}

.type,
.meta,
.time {
  color: #666;
  font-size: 24rpx;
}

.meta {
  margin-top: 12rpx;
  display: block;
}

.actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.btn {
  min-width: 136rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0 24rpx;
}

.btn.primary {
  background: #f6b73c;
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.conversation {
  border: 1rpx solid #f0f0f0;
}

.conversation-item {
  display: flex;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}

.avatar-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef2f7;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background: linear-gradient(135deg, #f6b73c, #e29a12);
}

.avatar-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.conversation-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.preview {
  color: #8b8b8b;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
