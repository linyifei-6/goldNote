<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <top-user-card
    user="{{goldViewDisplayUser || user}}"
    showMessageBadge="{{true}}"
    unreadMessageCount="{{unreadMessageCount}}"
    bindavatar="onOpenProfileModal"
    bindopenselector="onGoSelector"
    bindwedding="onGoWedding"
    bindopenmessage="onOpenMessageCenter"
    bindsocial="onGoSocial"
  />

  <view class="gold-view-banner" wx:if="{{isGoldReadOnly}}">
    <text class="gold-view-text">正在查看用户：{{goldViewTargetName}}</text>
    <button class="gold-view-btn" bindtap="onReturnToMyHome">返回我的主页</button>
  </view>

  <view class="card" wx:if="{{isGoldReadOnly}}">
    <view class="card-title">当前为只读模式</view>
    <view class="empty-text">你正在查看关注对象的黄金数据，交易录入已禁用。</view>
  </view>

  <!-- 交易类型选择 -->
  <view class="card" wx:if="{{!isGoldReadOnly}}">
    <view class="card-title">交易类型</view>
    <view class="type-selector">
      <view class="type-item {{transactionType === 'buy' ? 'active' : ''}}" bindtap="selectBuy">
        <text class="type-icon">📈</text>
        <text class="type-text">买入</text>
      </view>
      <view class="type-item {{transactionType === 'sell' ? 'active' : ''}}" bindtap="selectSell">
        <text class="type-icon">📉</text>
        <text class="type-text">卖出</text>
      </view>
    </view>
  </view>

  <!-- 交易表单 -->
  <view class="card" wx:if="{{!isGoldReadOnly}}">
    <view class="card-title">交易信息</view>

    <view class="compact-grid">
      <view class="form-item compact-item">
        <text class="form-label">成交价格（元/克）</text>
        <input class="form-input" type="digit" placeholder="成交价格" value="{{price}}" bindinput="onPriceInput" />
      </view>

      <view class="form-item compact-item">
        <text class="form-label">交易克数</text>
        <input class="form-input" type="digit" placeholder="交易克数" value="{{weight}}" bindinput="onWeightInput" />
      </view>
    </view>

    <view class="form-item compact-item inline-item">
      <text class="form-label inline-label">交易平台</text>
      <view class="chip-group inline-chip-group">
        <view
          class="chip-btn {{platformIndex === index ? 'active' : ''}}"
          wx:for="{{platforms}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onPlatformTap"
        >
          <text class="chip-btn-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="form-item compact-item" wx:if="{{showPlatformNameInput}}">
      <text class="form-label">平台名称</text>
      <input class="form-input" placeholder="输入平台名称（最多20字）" value="{{platformName}}" bindinput="onPlatformNameInput" />
    </view>

    <view class="form-item compact-item" wx:if="{{showPlatformFeeInput}}">
      <text class="form-label">手续费率（小数）</text>
      <input class="form-input" type="digit" placeholder="例如 0.004 表示 0.4%" value="{{platformFeeRate}}" bindinput="onPlatformFeeRateInput" />
    </view>

    <view class="form-item compact-item inline-item">
      <text class="form-label inline-label">交易日期</text>
      <picker class="form-picker inline-picker" mode="date" value="{{date}}" end="{{today}}" bindchange="onDateChange">
        <view class="unified-date-picker">
          <view class="unified-date-inner">
            <text class="unified-date-tag">日</text>
            <text class="unified-date-value">{{date || '请选择日期'}}</text>
          </view>
        </view>
      </picker>
    </view>

    <!-- 费用预览 -->
    <view class="fee-preview" wx:if="{{transactionType === 'sell' && price && weight}}">
      <view class="fee-row">
        <text class="fee-label">卖出手续费率</text>
        <text class="fee-value">{{feeRateText}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-label">手续费金额</text>
        <text class="fee-value">¥{{fmt.toFixed(feeAmount, 2)}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-label">实际到账</text>
        <text class="fee-value highlight">¥{{fmt.toFixed(netAmount, 2)}}</text>
      </view>
    </view>

    <view class="fee-preview" wx:if="{{transactionType === 'buy' && price && weight}}">
      <view class="fee-row">
        <text class="fee-label">交易金额</text>
        <text class="fee-value highlight">¥{{fmt.toFixed(displayAmount, 2)}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="btn-container" wx:if="{{!isGoldReadOnly}}">
    <button class="btn {{transactionType === 'sell' ? 'btn-sell' : ''}}" bindtap="submitTransaction">
      {{transactionType === 'buy' ? '模拟买入' : '模拟卖出'}}
    </button>
  </view>

  <!-- 持仓提示 -->
  <view class="holding-info" wx:if="{{!isGoldReadOnly && transactionType === 'sell' && platformHolding > 0}}">
    <text class="info-text">当前平台可卖出：{{fmt.toFixed(platformHolding, 2)}} 克</text>
  </view>

  <!-- 最近成交记录 -->
  <view class="card">
    <view class="card-title">最新成交记录</view>
    <view wx:if="{{recentTransactions.length === 0}}" class="empty-text">暂无成交记录</view>
    <view wx:for="{{recentTransactions}}" wx:key="id" class="recent-item compact-record">
      <view class="recent-row">
        <text class="recent-id">{{item.id}}</text>
        <text class="recent-type {{item.type === 'buy' ? 'buy' : 'sell'}}">{{item.type === 'buy' ? '买入' : '卖出'}}</text>
      </view>
      <view class="recent-row">
        <text class="recent-meta">平台：{{item.platform}}</text>
        <text class="recent-meta">时间：{{item.displayTime}}</text>
      </view>
      <view class="recent-row">
        <text class="recent-meta">金额：¥{{fmt.toFixed(item.net_amount, 2)}}</text>
        <text class="recent-meta">克重：{{fmt.toFixed(item.weight, 2)}}g</text>
        <text class="recent-meta">价格：¥{{fmt.toFixed(item.price, 2)}}</text>
      </view>
      <view class="recent-row" wx:if="{{item.fee_amount > 0}}">
        <text class="recent-meta fee">手续费：¥{{fmt.toFixed(item.fee_amount, 2)}}</text>
      </view>
    </view>
  </view>

  <view class="profile-modal-mask" wx:if="{{profileModalVisible}}" bindtap="onCloseProfileModal"></view>
  <view class="profile-modal-card" wx:if="{{profileModalVisible}}">
    <view class="profile-modal-head">
      <text class="profile-title">个人信息</text>
      <text class="profile-close" bindtap="onCloseProfileModal">关闭</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">头像</text>
      <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
        <image class="profile-avatar" src="{{user.avatarUrl || '/images/主页.png'}}" mode="aspectFill" />
        <text class="profile-op">修改</text>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">ID</text>
      <view class="profile-value-wrap">
        <text class="profile-value">{{user.id}}</text>
        <view class="profile-copy-btn" bindtap="onCopyUserId">
          <image class="profile-copy-icon" src="/images/复制.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">昵称</text>
      <input class="profile-input" placeholder="请输入昵称" maxlength="20" value="{{profileNicknameDraft}}" bindinput="onProfileNicknameInput" />
    </view>
    <view class="profile-safe-actions">
      <button class="profile-save-btn" bindtap="onSaveProfileNickname" loading="{{profileSaving}}">保存昵称</button>
      <button class="profile-action-btn neutral" bindtap="onCloseProfileModal" disabled="{{profileSaving}}">关闭</button>
    </view>
  </view>

</view>