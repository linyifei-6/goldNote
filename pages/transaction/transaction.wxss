.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #f7f3ef;
}

.profile-modal-mask { position: fixed; inset: 0; background: rgba(15,23,42,0.45); z-index: 880; }
.profile-modal-card { position: fixed; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 84%; background: #fff; border-radius: 18rpx; padding: 26rpx; z-index: 881; }
.profile-modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.profile-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.profile-close { font-size: 22rpx; color: #64748b; }
.profile-row { margin-bottom: 10rpx; }
.profile-label { display: block; margin-bottom: 6rpx; color: #475569; font-size: 22rpx; }
.profile-avatar-wrap, .profile-value-wrap { display: flex; align-items: center; gap: 10rpx; }
.profile-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #f1f5f9; }
.profile-op { color: #0369a1; font-size: 21rpx; }
.profile-value { flex: 1; color: #334155; font-size: 22rpx; word-break: break-all; }
.profile-copy-btn { width: 52rpx; height: 52rpx; border-radius: 12rpx; background: #f8fafc; border: 1rpx solid #dbe7f3; display: flex; align-items: center; justify-content: center; }
.profile-copy-icon { width: 28rpx; height: 28rpx; }
.profile-input { width: 100%; height: 78rpx; border-radius: 12rpx; background: #f3f4f6; padding: 0 16rpx; font-size: 28rpx; color: #111827; box-sizing: border-box; }
.profile-safe-actions { margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.profile-save-btn, .profile-action-btn { width: 100%; min-height: 72rpx; line-height: 72rpx; border-radius: 14rpx; font-size: 24rpx; }
.profile-save-btn { border: 1rpx solid #a5f3fc; background: #ecfeff; color: #0e7490; }
.profile-danger-zone { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx dashed #f5d0d8; }
.profile-danger-title { display: block; margin-bottom: 10rpx; font-size: 20rpx; color: #be123c; }
.profile-action-row { display: flex; gap: 10rpx; }
.profile-action-btn { flex: 1; border: 1rpx solid transparent; box-sizing: border-box; }
.profile-action-btn.neutral { border: 1rpx solid #e2e8f0; background: #f1f5f9; color: #334155; }
.profile-action-btn.danger { background: #ffe4e6; color: #9f1239; border-color: #fecdd3; }
.profile-action-btn.warn { background: #fff7ed; color: #b45309; border-color: #fed7aa; }

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.view-mode-card {
  border: 1rpx solid #efe2cb;
}

.view-mode-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.view-mode-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5f471f;
}

.view-mode-tip {
  font-size: 20rpx;
  color: #a66c22;
  background: #fbf2e3;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.view-mode-picker {
  min-height: 56rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #555;
}

.compact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.compact-item {
  margin-bottom: 10rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e0e0e0;
  background: #f9f9f9;
  transition: all 0.3s;
}

.type-item.active {
  border-color: #d9953f;
  background: linear-gradient(135deg, rgba(239, 195, 121, 0.18), rgba(217, 149, 63, 0.1));
}

.type-item.active.btn-sell {
  border-color: #ff5252;
  background: linear-gradient(135deg, rgba(255, 82, 82, 0.1), rgba(211, 47, 47, 0.1));
}

.type-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.type-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.form-item {
  margin-bottom: 10rpx;
}

.form-label {
  font-size: 23rpx;
  color: #666;
  margin-bottom: 6rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 68rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 14rpx;
  font-size: 24rpx;
  color: #333;
}

.form-picker {
  width: 100%;
  height: 68rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
  font-size: 24rpx;
  color: #333;
}

.picker {
  flex: 1;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999;
  margin-left: 16rpx;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.chip-btn {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #f3f3f3;
  border: 1rpx solid #e8e8e8;
}

.chip-btn.active {
  background: #f8ead1;
  border-color: #e4c38f;
}

.chip-btn-text {
  font-size: 22rpx;
  color: #6d532e;
}

.inline-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.inline-label {
  margin-bottom: 0;
  min-width: 120rpx;
  flex-shrink: 0;
}

.inline-chip-group {
  flex: 1;
}

.inline-picker {
  flex: 1;
  margin-top: 0;
}

.fee-preview {
  background: #f9f9f9;
  border-radius: 10rpx;
  padding: 12rpx;
  margin-top: 8rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.fee-label {
  font-size: 24rpx;
  color: #666;
}

.fee-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.fee-value.highlight {
  color: #d9953f;
  font-weight: bold;
  font-size: 28rpx;
}

.btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: white;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #efc379, #d9953f);
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(217, 149, 63, 0.4);
  text-align: center;
}

.btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.gold-view-banner {
  margin: 12rpx 0;
  padding: 8rpx 12rpx;
  background: #fff3e0;
  border: 1rpx solid #f9bd9e;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.gold-view-text {
  color: #c1621f;
  font-size: 24rpx;
}

.gold-view-btn {
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  border: none;
  background: #f59e3b;
  color: #fff;
  font-size: 22rpx;
}


.btn-sell {
  background: linear-gradient(135deg, #ff5252, #d32f2f);
  box-shadow: 0 4rpx 12rpx rgba(255, 82, 82, 0.4);
}

.holding-info {
  text-align: center;
  padding: 14rpx;
  margin-top: 14rpx;
}

.info-text {
  font-size: 24rpx;
  color: #999;
}

.empty-text {
  color: #999;
  font-size: 24rpx;
}

.recent-item {
  border-top: 1rpx solid #f0f0f0;
  padding: 10rpx 0;
}

.compact-record .recent-meta {
  font-size: 20rpx;
}

.recent-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.recent-row:last-child {
  margin-bottom: 0;
}

.recent-id {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
}

.recent-type {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.recent-type.buy {
  color: #ff5252;
  background: rgba(255, 82, 82, 0.1);
}

.recent-type.sell {
  color: #4caf50;
  background: rgba(76, 175, 80, 0.1);
}

.recent-meta {
  font-size: 22rpx;
  color: #666;
}

.recent-meta.fee {
  color: #d9953f;
  font-weight: 500;
}