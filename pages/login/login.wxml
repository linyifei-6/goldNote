<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="container">
  <view class="card">
    <view class="title">双笔记中心</view>
    <view class="subtitle">微信账号是唯一身份认证，昵称仅用于展示</view>

    <input
      class="form-input"
      placeholder="请输入昵称（可选，最大20字）"
      value="{{nickname}}"
      maxlength="20"
      bindinput="onNicknameInput"
    />

    <button class="btn-wechat" bindtap="onWechatLogin" loading="{{loginLoading}}">
      <text class="wechat-icon">❤️</text>
      <text class="wechat-text">微信登录</text>
    </button>
    <view class="wechat-tip">点击后直接完成微信身份登录，无需授权</view>

    <view class="divider">—— 或 ——</view>

    <button class="btn-guest" bindtap="onGuestLogin" loading="{{loginLoading}}">
      <text class="guest-icon">❤️</text>
      <text class="guest-text">游客模式</text>
    </button>
    <view class="guest-tip">无需微信账号，数据仅保存在本地</view>
  </view>
</view>
