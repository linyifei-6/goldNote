.container {
  min-height: 100vh;
  padding: 36rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #f7f8fb 56%, #eff4ff 100%);
}

.portal-tip {
  margin: 4rpx 6rpx 18rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.portal-entry-row {
  display: flex;
  gap: 12rpx;
  margin: 0 4rpx 18rpx;
}

.portal-entry-btn {
  flex: 1;
  text-align: center;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f3;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}

.guest-card {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.guest-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
}

.guest-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6b7280;
}

.guest-login-btn {
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #e6fbff;
  color: #0e7490;
  border: 2rpx solid #8fe7f2;
  font-size: 28rpx;
  min-height: 94rpx;
  line-height: 94rpx;
  box-shadow: 0 10rpx 24rpx rgba(14, 116, 144, 0.18);
}

.guest-login-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.guest-login-star {
  width: 34rpx;
  height: 34rpx;
}

.guest-login-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0e7490;
}

.guest-mode-btn {
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #9ca3af;
  border: 1rpx solid #d1d5db;
  font-size: 20rpx;
  min-height: 70rpx;
  line-height: 70rpx;
  white-space: nowrap;
}

.guest-id-bar {
  margin: 0 0 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.guest-id-label {
  font-size: 20rpx;
  color: #92400e;
  margin-right: 10rpx;
}

.guest-id-value {
  font-size: 20rpx;
  color: #78350f;
}

.choice-card {
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
}

.choice-card.gold {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.choice-card.wedding {
  background: linear-gradient(135deg, #f7c6df, #f5b1d1);
}

.choice-card.workout {
  background: linear-gradient(135deg, #34d399, #10b981);
}

.choice-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.choice-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.95);
  font-size: 25rpx;
}

.choice-cta {
  margin-top: 24rpx;
  display: inline-block;
  color: #111827;
  background: rgba(255, 255, 255, 0.92);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.logout-btn {
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.profile-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 880;
}

.profile-modal-card {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.28);
  z-index: 881;
}

.profile-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.profile-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.profile-close {
  font-size: 22rpx;
  color: #64748b;
}

.profile-row {
  margin-bottom: 10rpx;
}

.profile-label {
  display: block;
  margin-bottom: 6rpx;
  color: #475569;
  font-size: 22rpx;
}

.profile-avatar-wrap,
.profile-value-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-op {
  color: #0369a1;
  font-size: 21rpx;
}

.profile-value {
  flex: 1;
  color: #334155;
  font-size: 22rpx;
  word-break: break-all;
}

.profile-copy-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #dbe7f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-copy-icon {
  width: 28rpx;
  height: 28rpx;
}

.profile-input {
  width: 100%;
  height: 78rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.profile-safe-actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-save-btn,
.profile-action-btn {
  width: 100%;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.profile-save-btn {
  border: 1rpx solid #a5f3fc;
  background: #ecfeff;
  color: #0e7490;
  min-height: 84rpx;
  line-height: 84rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.profile-danger-zone {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #f5d0d8;
}

.profile-danger-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  color: #be123c;
}

.profile-action-row {
  display: flex;
  gap: 10rpx;
}

.profile-action-row.split .profile-action-btn.warn {
  font-size: 22rpx;
}

.profile-action-btn {
  flex: 1;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.profile-action-btn.neutral {
  border: 1rpx solid #e2e8f0;
  background: #f1f5f9;
  color: #334155;
}

.profile-action-btn.danger {
  background: #ffe4e6;
  color: #9f1239;
  border-color: #fecdd3;
}

.profile-action-btn.warn {
  background: #fff7ed;
  color: #b45309;
  border-color: #fed7aa;
}

.choice-card.quiz {
  background: linear-gradient(135deg, #667eea, #764ba2);
}
.choice-card.quiz .choice-cta {
  color: #667eea;
  border-color: #667eea;
}
