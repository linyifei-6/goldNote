<view class="container">
  <top-user-card
    user="{{user}}"
    showQuickActions="{{false}}"
    bindavatar="onOpenProfileModal"
    bindopenselector="noop"
    bindopenmessage="onGoMessages"
    bindsocial="onGoSocial"
  />

  <view class="guest-card" wx:if="{{!user}}">
    <view class="guest-title">先体验，再登录</view>
    <view class="guest-desc">可先浏览功能说明，访客模式下数据仅保存本地</view>
    <button class="guest-login-btn" bindtap="onGoLogin">
      <view class="guest-login-inner">
        <image class="guest-login-star" src="/images/星星-active.png" mode="aspectFit" />
        <text class="guest-login-text">微信登录（推荐）</text>
      </view>
    </button>
    <button class="guest-mode-btn" bindtap="onGoGuestMode">访客模式（数据仅保存本地）</button>
  </view>

  <view class="guest-id-bar" wx:if="{{user && user.isGuest}}">
    <text class="guest-id-label">当前访客ID</text>
    <text class="guest-id-value">{{guestUserId}}</text>
  </view>

  <view class="portal-tip" wx:if="{{user}}">请选择要进入的笔记场景</view>
  <view class="portal-tip" wx:else>请选择要体验的笔记场景</view>

  <view class="portal-entry-row">
    <view class="portal-entry-btn" bindtap="onGoSocial">好友列表</view>
    <view class="portal-entry-btn" bindtap="onGoMessages">消息中心</view>
  </view>

  <view class="choice-card gold" bindtap="onGoGold">
    <view class="choice-title">黄金笔记</view>
    <view class="choice-desc">黄金持仓、交易记录、收益分析</view>
    <view class="choice-cta">进入黄金笔记</view>
  </view>

  <view class="choice-card wedding" bindtap="onGoWedding">
    <view class="choice-title">结婚笔记</view>
    <view class="choice-desc">按结婚阶段管理任务、预算和提醒记录</view>
    <view class="choice-cta">进入结婚笔记</view>
  </view>

  <view class="choice-card workout" bindtap="onGoWorkout">
    <view class="choice-title">运动笔记</view>
    <view class="choice-desc">分析总览、运动记录、计划打卡与减脂趋势</view>
    <view class="choice-cta">进入运动分析</view>
  </view>

  <view class="choice-card quiz" bindtap="onGoQuiz">
    <view class="choice-title">竞猜笔记</view>
    <view class="choice-desc">世界杯竞猜、赛程浏览、下注积分</view>
    <view class="choice-cta">进入竞猜笔记</view>
  </view>

  <view class="profile-modal-mask" wx:if="{{profileModalVisible}}" bindtap="onCloseProfileModal"></view>
  <view class="profile-modal-card" wx:if="{{profileModalVisible}}">
    <view class="profile-modal-head">
      <text class="profile-title">个人信息</text>
      <text class="profile-close" bindtap="onCloseProfileModal">关闭</text>
    </view>
    <view class="profile-row">
      <text class="profile-label">头像</text>
      <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
        <image class="profile-avatar" src="{{user.avatarUrl || '/images/主页.png'}}" mode="aspectFill" />
        <text class="profile-op">修改</text>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">ID</text>
      <view class="profile-value-wrap">
        <text class="profile-value">{{user.id}}</text>
        <view class="profile-copy-btn" bindtap="onCopyUserId">
          <image class="profile-copy-icon" src="/images/复制.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view class="profile-row">
      <text class="profile-label">昵称</text>
      <input class="profile-input" placeholder="请输入昵称" maxlength="20" value="{{profileNicknameDraft}}" bindinput="onProfileNicknameInput" />
    </view>
    <view class="profile-safe-actions">
      <button class="profile-save-btn" bindtap="onSaveProfileNickname" loading="{{profileSaving}}">保存昵称</button>
      <button class="profile-action-btn neutral" bindtap="onCloseProfileModal" disabled="{{profileSaving}}">关闭</button>
    </view>
    <view class="profile-danger-zone">
      <text class="profile-danger-title">高风险操作</text>
      <view class="profile-action-row">
        <button class="profile-action-btn danger" bindtap="onLogout">退出登录</button>
      </view>
      <view class="profile-action-row split">
        <button class="profile-action-btn warn" bindtap="onClearGoldData">清除黄金笔记数据</button>
        <button class="profile-action-btn warn" bindtap="onClearWeddingData">清除婚礼笔记数据</button>
      </view>
    </view>
  </view>
</view>
